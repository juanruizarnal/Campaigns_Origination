# =============================================================================
# ALTER-5 ORIGINATION ENGINE - PRODUCTION CONFIGURATION
# =============================================================================
# Copy this file to .env.production and fill in your values
# NEVER commit the actual .env.production file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# -----------------------------------------------------------------------------
# CORE LLM APIs (Required)
# -----------------------------------------------------------------------------
# Anthropic Claude API - Get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API - Get key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API (for embeddings) - Get key at https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# DATABASE & STORAGE (Required)
# -----------------------------------------------------------------------------
# Airtable - Get PAT at https://airtable.com/create/tokens
AIRTABLE_PAT=patxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appEgNSP0tOLJ9YJ9

# Redis - Your Redis instance URL
# Railway: Use the REDIS_URL from your Railway Redis service
# Render: Use Upstash Redis free tier
# Local: redis://localhost:6379/0
REDIS_URL=redis://default:password@your-redis-host:6379

# MongoDB Atlas (free tier) - Get at https://www.mongodb.com/cloud/atlas
# Create free M0 cluster and get connection string
MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/alter5?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# API SECURITY (Required for Production)
# -----------------------------------------------------------------------------
# Generate a secure API key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALTER5_API_KEY=your-secure-api-key-here

# CORS - Comma-separated list of allowed origins
# Include your frontend URL and any other clients
CORS_ORIGINS=https://your-app.railway.app,https://your-app.render.com

# -----------------------------------------------------------------------------
# NOTIFICATIONS (Recommended)
# -----------------------------------------------------------------------------
# Slack - Create bot at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxx-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ORIGINATION=#origination-alerts
SLACK_CHANNEL_HOT_LEADS=#hot-leads

# -----------------------------------------------------------------------------
# EMAIL MARKETING (Optional - for automated campaigns)
# -----------------------------------------------------------------------------
# Mailchimp - Get API key at https://mailchimp.com/help/about-api-keys/
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us14
MAILCHIMP_SERVER_PREFIX=us14
MAILCHIMP_LIST_ID=xxxxxxxxxx

# -----------------------------------------------------------------------------
# DATA ENRICHMENT (Optional - for LinkedIn data)
# -----------------------------------------------------------------------------
# Proxycurl - Get key at https://nubela.co/proxycurl/
PROXYCURL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# LLM MODEL CONFIGURATION
# -----------------------------------------------------------------------------
# Models to use (can upgrade based on your plan)
CLAUDE_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.0-flash

# Timeouts and retries
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# BUSINESS RULES
# -----------------------------------------------------------------------------
# Cooling-off period (days between contacting same company)
COOLING_OFF_DAYS=90

# Maximum targets per campaign
MAX_TARGETS_PER_CAMPAIGN=30
MAX_TARGETS_MASS_CAMPAIGN=200

# Minimum fit score to include target
MIN_FIT_SCORE=0.6

# Email length limits
MAX_EMAIL_WORDS=150
MAX_SUBJECT_CHARS=80

# Follow-up timing
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7
MAX_FOLLOWUPS=2

# -----------------------------------------------------------------------------
# DEPLOYMENT PLATFORM SPECIFIC
# -----------------------------------------------------------------------------
# Railway
# RAILWAY_ENVIRONMENT=production

# Render
# RENDER=true

# Fly.io
# FLY_APP_NAME=alter5-origination

# -----------------------------------------------------------------------------
# MONITORING (Optional but recommended)
# -----------------------------------------------------------------------------
# Sentry for error tracking - https://sentry.io/
# SENTRY_DSN=https://xxxxxxxx@xxxxx.ingest.sentry.io/xxxxxxx

# -----------------------------------------------------------------------------
# NOTES FOR PRODUCTION
# -----------------------------------------------------------------------------
# 1. Use Railway/Render/Fly.io environment variables UI to set these
# 2. Never commit secrets to git
# 3. Rotate API keys periodically
# 4. Monitor usage and costs on each API dashboard
# 5. Set up alerts for rate limit warnings
